# Copy to .env (Docker Compose reads it automatically). For local dev without
# Docker, export these in your shell; the frontend reads web/.env.local.
# Never commit .env: it holds the database password.

# ---- Database (PostgreSQL + PostGIS; scenarios and the recorder need it)
# Required by Docker Compose. Choose your own value.
POSTGRES_PASSWORD=change-me
# Local development only (Compose builds its own URL from POSTGRES_PASSWORD).
# Example for a PostGIS container published on 5433:
#   docker run -d --name nexus-postgis-dev -e POSTGRES_USER=nexus -e POSTGRES_PASSWORD=<pw> \
#     -e POSTGRES_DB=nexus -p 127.0.0.1:5433:5432 postgis/postgis:17-3.5-alpine
DATABASE_URL=postgres://nexus:change-me@localhost:5433/nexus

# ---- Simulation worker (core/cmd/sim)
SIM_SEED=42                # city layout and every random stream derive from this
SIM_SPEED=10               # 1, 2, 5, 10 or 60 (×real time)
SIM_START_PAUSED=false
SIM_RESUME=true            # on restart, continue the previous run instead of starting over
SIM_HEALTH_ADDR=:8081      # /healthz for container and Kubernetes probes

# ---- Shared
# Compose overrides this to redis://redis:6379/0. Use another DB number if
# your local Redis is shared with other projects.
REDIS_URL=redis://localhost:6379/0

# ---- Gateway (core/cmd/gateway)
GATEWAY_ADDR=:8080
GATEWAY_PORT=8080                       # port Compose publishes the gateway on
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; "*" allows any origin
GATEWAY_HISTORY_LIMIT=1440              # telemetry snapshots kept in memory (simulated minutes, ~40 KB each)

# ---- Scenario worker (core/cmd/scenario)
# One URL serving every model, or per-model: traffic=http://a:8090,energy=http://b:8090,pm25=http://c:8090
MODEL_URLS=http://localhost:8090
SCENARIO_HEALTH_ADDR=:8082

# ---- Recorder (core/cmd/recorder): data retention
RETENTION_SIM_DAYS=7       # keep observations, events and forecasts for this many simulated days per run
RETENTION_RUNS=3           # keep this many most recent live runs
RETENTION_SCENARIOS=200    # keep this many most recent finished scenarios
RECORDER_HEALTH_ADDR=:8083

# ---- City Intelligence assistant (assistant/)
# Without a key the assistant runs in rule-based mode (no LLM, still answers
# from live data). Any OpenAI-compatible Chat Completions endpoint with
# function tools works; the default is Google's Gemini endpoint.
LLM_API_KEY=                 # or GEMINI_API_KEY; never commit a real key
LLM_BASE_URL=                # default https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=                   # default gemini-flash-lite-latest
LLM_FALLBACK_MODEL=          # default gemini-3.5-flash; "none" disables
LLM_REASONING_EFFORT=        # default "low" on Gemini, unset elsewhere; "off" never sends it
LLM_TIMEOUT_S=               # per model request, default 45 (then the fallback model is tried)
ASSISTANT_MODE=              # "rules" forces rule-based mode even with a key
# Local development only (Compose wires these itself):
#   GATEWAY_URL=http://localhost:8080         for the assistant
#   ASSISTANT_URL=http://localhost:8095       for the gateway's /api/assistant proxy

# ---- Frontend (web/, build time)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
WEB_PORT=3000                           # port Compose publishes the web app on
